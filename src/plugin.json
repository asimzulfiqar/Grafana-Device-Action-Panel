{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "Grafana Device Action Panel",
  "id": "asim-deviceaction-app",
  "backend": true,
  "executable": "gpx_device_action",
  "info": {
    "keywords": ["iot", "device", "actions", "operations"],
    "description": "Safe, validated, and auditable IoT actions from Grafana dashboards.",
    "author": { "name": "Asim" },
    "logos": { "small": "img/logo.svg", "large": "img/logo.svg" },
    "screenshots": [
      { "name": "Provisioned device action dashboard", "path": "img/screenshots/demo-dashboard.png" },
      { "name": "Typed reboot confirmation", "path": "img/screenshots/reboot-confirmation.png" },
      { "name": "Panel-side connector settings", "path": "img/screenshots/connector-side-menu.png" }
    ],
    "version": "0.1.0",
    "updated": "2026-06-01"
  },
  "includes": [
    {
      "type": "page",
      "name": "Device Actions",
      "path": "/a/asim-deviceaction-app",
      "addToNav": true,
      "defaultNav": true
    },
    {
      "type": "page",
      "icon": "cog",
      "name": "Configuration",
      "path": "/plugins/asim-deviceaction-app",
      "role": "Admin",
      "addToNav": true
    },
    {
      "type": "panel",
      "name": "Device Action Panel",
      "path": "device-action-panel/plugin.json"
    }
  ],
  "dependencies": { "grafanaDependency": ">=12.3.0", "plugins": [] }
}
