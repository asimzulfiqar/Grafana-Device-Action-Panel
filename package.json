{
  "name": "grafana-device-action-panel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "webpack -c ./.config/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack.config.ts --env development",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "server": "docker compose up --build"
  },
  "dependencies": {
    "@emotion/css": "11.10.6",
    "@grafana/data": "12.4.2",
    "@grafana/runtime": "12.4.2",
    "@grafana/ui": "12.4.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@grafana/plugin-e2e": "^3.9.0",
    "@playwright/test": "^1.60.0",
    "@swc/core": "^1.15.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "caniuse-lite": "^1.0.30001793",
    "copy-webpack-plugin": "^13.0.0",
    "css-loader": "^7.1.0",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "5.9.2",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
